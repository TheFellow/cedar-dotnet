digraph Workflow {
  graph [ label="Semport Ledger Archiver", goal="Archive old ledger entries to keep the active ledger manageable.\n\nMove ledger rows older than 90 days from semport/ledger.tsv to semport/archives/ledger-YYYYMMDD.tsv, where YYYYMMDD is today's date.\n\nEnsure each commit appears only in the active ledger OR in exactly one archive file, never duplicated.\n\nThe active ledger should contain recent commits (within 90-day window) for active porting work.", rankdir="LR", context_fidelity_default="truncate", context_thread_default="semport-archiver", default_max_retry="2" ];

  PerformArchival [allow_partial="false", color="#94a3b8", fillcolor="white", fontname="Helvetica", fontsize="12", is_codergen="true", label="1) Archive old ledger entries (gpt-5.4)", llm_model="gpt-5.4", llm_prompt="Our goal is: $goal\n\n---\n\nArchive ledger entries older than 90 days:\n\n1. Calculate today's date minus 90 days (the cutoff date)\n2. Read semport/ledger.tsv and identify all rows with iso8601 timestamps OLDER than the cutoff\n3. If rows exist to archive:\n   - Create/append to semport/archives/ledger-YYYYMMDD.tsv (where YYYYMMDD is today's date in that format)\n   - Write the old rows to the archive file (TSV format with header if new file, or append without header if exists)\n   - Remove those rows from semport/ledger.tsv, keeping all other rows\n4. Write a summary to .ai/archive_summary.md with: count archived, date range, archive filename, count remaining in active ledger\n5. If no rows are old enough, write to summary that ledger is already within 90-day window", llm_provider="openai", margin="0.1,0.08", max_agent_turns="8", node_type="stack.observe", penwidth="1.2", reasoning_effort="medium", shape="box", style="rounded,filled", timeout="1200"];

  Verify [allow_partial="false", color="#94a3b8", fillcolor="white", fontname="Helvetica", fontsize="12", is_codergen="true", label="2) Verify archival (gpt-5.4)", llm_model="gpt-5.4", llm_prompt="Verify the archival was done correctly:\n\n1. Read semport/ledger.tsv - confirm all remaining rows have timestamps within the last 90 days\n2. If an archive was created, read it and confirm the archived rows are properly formatted TSV\n3. Check that no commit appears in both the active ledger and any archive file (no duplicates)\n4. Use outcome=yes if verification passes, outcome=retry if any issues found", llm_provider="openai", margin="0.1,0.08", max_agent_turns="5", node_type="stack.steer", penwidth="1.2", reasoning_effort="medium", shape="box", style="rounded,filled", timeout="600"];

  Exit [allow_partial="false", color="#94a3b8", fillcolor="white", fontname="Helvetica", fontsize="12", is_codergen="true", label="Exit", llm_model="gpt-5.4", llm_provider="openai", margin="0.1,0.08", max_agent_turns="2", node_type="exit", penwidth="1.2", reasoning_effort="medium", shape="doublecircle", style="rounded,filled", timeout="300"];

  Start [allow_partial="false", color="#94a3b8", fillcolor="white", fontname="Helvetica", fontsize="12", is_codergen="true", label="Start", llm_model="gpt-5.4", llm_provider="openai", margin="0.1,0.08", max_agent_turns="2", node_type="start", penwidth="1.2", reasoning_effort="medium", shape="circle", style="rounded,filled", timeout="300"];

  Start -> PerformArchival;
  PerformArchival -> Verify;
  Verify -> Exit [condition="outcome=yes", label="verified"];
  Verify -> PerformArchival [condition="outcome=retry", label="fix issues"];
}
